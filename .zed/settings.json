{
    "languages": {
        "TypeScript": {
            "language_servers": ["eslint", "..."]
        },
        "TSX": {
            "language_servers": ["eslint", "..."]
        },
        "JavaScript": {
            "language_servers": ["eslint", "..."]
        }
    },
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "linkedProjects": ["./src-tauri/Cargo.toml"],
                "check": {
                    "command": "clippy"
                }
            }
        }
    },
    "file_types": {
        "Plain Text": ["pnpm-lock.yaml"]
    }
}
